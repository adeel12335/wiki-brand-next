# The Wikipedia Studio — Apache configuration
#
# Routing needs no rewrites: every page is a directory containing index.php, so
# /services/wikipedia-page-creation/ resolves natively on Apache and nginx alike.
# The rules below handle canonicalisation, the XML sitemap, caching, and headers.
# See README.md for the nginx equivalents.

AddDefaultCharset UTF-8
DirectoryIndex index.php index.html

# Trailing slashes for directory URLs (Apache default, stated explicitly).
DirectorySlash On

ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonical host and scheme -----------------------------------------
  # Force HTTPS. Both conditions are needed: %{HTTPS} for direct requests and
  # X-Forwarded-Proto for requests arriving through a load balancer or CDN.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- One URL per page --------------------------------------------------
  # /about-us/index.php and /index.php collapse onto the clean directory URL.
  RewriteCond %{THE_REQUEST} \s[^?]*/index\.php[\s?] [NC]
  RewriteRule ^(.*)index\.php$ $1 [R=301,L]

  # A .php extension typed by hand redirects to the clean URL.
  RewriteCond %{THE_REQUEST} \s[^?]*\.php[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/(404|sitemap|robots)\.php$ [NC]
  RewriteRule ^(.+)\.php$ $1/ [R=301,L]

  # --- Database-driven portfolio pages -----------------------------------
  # /portfolio/<slug>/ is served by portfolio/item.php. The condition keeps the
  # real /portfolio/ directory and any real file working normally.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^portfolio/([A-Za-z0-9-]+)/?$ portfolio/item.php?slug=$1 [L,QSA]

  # --- Generated SEO files ------------------------------------------------
  # Dynamic versions carry the correct absolute host. If a static sitemap.xml or
  # robots.txt has been generated (see bin/build-seo-files.php), it wins.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^robots\.txt$ robots.php [L]

  # --- Keep internals private ---------------------------------------------
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^bin/ - [F,L]
  RewriteRule ^storage/ - [F,L]
</IfModule>

# --- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Browser caching ------------------------------------------------------
# CSS and JS are requested with a ?v= modification-time stamp, so a long cache
# is safe — a changed file gets a new URL.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# --- Security and privacy headers ----------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header unset X-Powered-By
</IfModule>

# --- Block dotfiles -------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
