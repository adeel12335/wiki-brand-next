# Site URL — REQUIRED in production
# Local: http://localhost:3000
# Production (Vercel/hosting): https://thewikipediastudio.com
# If production still has localhost, getSiteUrl() falls back to https://thewikipediastudio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Search Console HTML-tag verification code (content value only)
# GOOGLE_SITE_VERIFICATION=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/wikistudio
# Optional: comma-separated DNS servers if mongodb+srv fails locally (e.g. 8.8.8.8,1.1.1.1)
MONGODB_DNS_SERVERS=

# Upstash Redis (free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Auth (admin)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email (contact form) — uses Resend HTTP API, NOT SMTP
# Create an API key at https://resend.com and verify your sending domain
RESEND_API_KEY=
CONTACT_TO=info@thewikipediastudio.com
# Must be a Resend-verified sender on your domain
CONTACT_FROM=info@thewikipediastudio.com

# Cloudflare Turnstile captcha (contact form)
# Dashboard: https://dash.cloudflare.com → Turnstile → Add widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# On-demand ISR revalidation
REVALIDATE_SECRET=
