# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/wikistudio
# Optional: comma-separated DNS servers if mongodb+srv fails locally (e.g. 8.8.8.8,1.1.1.1)
MONGODB_DNS_SERVERS=

# Upstash Redis (free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Auth (admin)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email (contact form)
RESEND_API_KEY=
CONTACT_TO=hello@thewikipediastudio.com

# On-demand ISR revalidation
REVALIDATE_SECRET=
